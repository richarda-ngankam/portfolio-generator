rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profil et réglages : visibles et modifiables par leur propriétaire seulement
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Brouillons et portfolios enregistrés : privés
    match /portfolios/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Copies publiées : l'identifiant du document EST l'adresse (donc unique)
    match /published/{slug} {
      allow get: if resource == null
                 || resource.data.visibility in ['public', 'unlisted']
                 || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.visibility in ['public', 'unlisted']
                    && slug.matches('^[a-z0-9-]{3,40}$');
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.visibility in ['public', 'unlisted'];
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}